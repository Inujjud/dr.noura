  if('IntersectionObserver' in window){
    var map=new Map();
    var io=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting){(map.get(e.target)||[]).forEach(function(x){x.classList.add('in')});io.unobserve(e.target)}})},{rootMargin:'0px 0px -6% 0px',threshold:0});
