<style>
/* Layout: RTL editorial one-pager built on the content strategy — diagnosis before treatment. Navy studio bands alternate with warm paper; identity-guide imagery only. */
:root{
  --navy:#111D35; --navy-2:#1A2846;
  --paper:#F5F0E7; --white:#FBF9F5;
  --gold:#CFA444; --skin:#DDBCB3; --mist:#D9E0E7;
  --ink:#171C29; --ink-2:#4d5466;
  --line:rgba(17,29,53,.12); --line-d:rgba(245,240,231,.16);
  --f-ar:"IBM Plex Sans Arabic","Noto Sans Arabic",Tahoma,sans-serif;
  --f-disp:"Cormorant Garamond",Georgia,"Times New Roman",serif;
  --f-util:"Montserrat","Helvetica Neue",Arial,sans-serif;
  color-scheme:light;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}*{transition:none!important;animation:none!important}}
body{margin:0;background:var(--paper);color:var(--ink);font-family:var(--f-ar);font-size:16px;line-height:1.85;direction:rtl;-webkit-font-smoothing:antialiased}
img{max-width:100%;display:block}
a{color:inherit}
:focus-visible{outline:2px solid var(--gold);outline-offset:3px}
.wrap{max-width:1120px;margin:0 auto;padding-left:max(20px,env(safe-area-inset-left,0px));padding-right:max(20px,env(safe-area-inset-right,0px))}
.en{font-family:var(--f-disp);direction:ltr;unicode-bidi:isolate}
.util{font-family:var(--f-util);direction:ltr;unicode-bidi:isolate;text-transform:uppercase;letter-spacing:.26em;font-size:11px;font-weight:600}
.eyebrow{display:flex;align-items:center;gap:14px;color:var(--gold)}
.eyebrow::after{content:"";height:1px;width:56px;background:var(--gold);opacity:.7}
h1,h2,h3{margin:0;font-weight:700;text-wrap:balance}
p{margin:0}
section{padding-block:104px}
.sec-head{display:flex;justify-content:space-between;align-items:flex-end;gap:24px;flex-wrap:wrap;margin-bottom:52px}
.sec-head h2{font-size:clamp(28px,3.4vw,42px);color:var(--navy);margin-top:16px;line-height:1.3}
.sec-head p{margin-top:14px;color:var(--ink-2);font-size:17px;max-width:36em}
.sec-head .en{font-size:24px;font-style:italic;color:var(--ink-2)}
.dark .sec-head h2{color:var(--paper)}
.dark .sec-head p,.dark .sec-head .en{color:var(--mist)}

/* header */
body::before{content:"";position:fixed;inset:0 0 auto;height:env(safe-area-inset-top,0px);z-index:20;background:var(--navy)}
header{position:sticky;top:env(safe-area-inset-top,0px);z-index:10;background:var(--navy);color:var(--paper);border-bottom:1px solid var(--line-d)}
header .wrap{display:flex;align-items:center;justify-content:space-between;gap:16px;padding-block:12px}
.brand{display:flex;align-items:center;gap:12px;text-decoration:none}
.brand img{height:34px;width:auto}
.brand span{color:var(--paper);font-size:10.5px}
nav{display:flex;gap:22px;flex-wrap:wrap}
nav a{text-decoration:none;font-size:14px;color:var(--mist);transition:color .2s}
nav a:hover{color:var(--gold)}

/* hero */
.hero{background:var(--navy);color:var(--paper);overflow:hidden;position:relative;padding-block:0}
.hero::before{content:"";position:absolute;width:780px;height:780px;border-radius:50%;border:1px solid rgba(207,164,68,.22);left:-420px;top:-260px;pointer-events:none}
.hero .wrap{display:grid;grid-template-columns:1.1fr .9fr;gap:48px;align-items:end;padding-block:72px 0}
.hero-text{padding-bottom:84px;min-width:0}
.hero h1{font-size:clamp(44px,6.4vw,76px);line-height:1.15;margin-top:22px}
.hero .en-name{font-size:clamp(24px,3vw,34px);color:var(--mist);margin-top:6px;font-style:italic}
.hero .position{margin-top:28px;font-size:clamp(19px,2vw,23px);line-height:1.7;max-width:26em;font-weight:500}
.hero .position em{font-style:normal;color:var(--gold)}
.hero .role{margin-top:26px;font-size:17px;color:var(--mist);max-width:34em}
.hero .where{margin-top:14px;font-size:15px;color:var(--mist)}
.hero .slogan{margin-top:26px;font-size:19px;font-style:italic;color:var(--skin)}
.actions{display:flex;flex-wrap:wrap;gap:12px;margin-top:36px}
.btn{display:inline-flex;align-items:center;gap:10px;padding:13px 22px;text-decoration:none;font-size:15px;font-weight:500;border:1px solid var(--gold);color:var(--paper);transition:background .2s,color .2s}
.btn:hover{background:var(--gold);color:var(--navy)}
.btn.ghost{border-color:var(--line-d)}
.btn.ghost:hover{background:var(--paper);color:var(--navy);border-color:var(--paper)}
.btn svg{width:18px;height:18px;flex:none}
.portrait{align-self:end;min-width:0}
.portrait img{width:100%;max-width:440px;margin-inline-start:auto;aspect-ratio:3/4;object-fit:cover;object-position:center top}

/* principle */
.principle .wrap{display:grid;grid-template-columns:1.2fr .8fr;gap:64px;align-items:center}
.principle blockquote{margin:22px 0 0;font-size:clamp(34px,4.6vw,58px);line-height:1.3;font-weight:700;color:var(--navy)}
.principle blockquote span{color:var(--gold)}
.principle .en-q{margin-top:14px;font-size:22px;font-style:italic;color:var(--ink-2)}
.principle p.lead{margin-top:28px;font-size:18px;color:var(--ink-2);max-width:34em}
.creds{margin:36px 0 0;border-top:1px solid var(--line)}
.creds div{display:grid;grid-template-columns:150px 1fr;gap:16px;padding-block:15px;border-bottom:1px solid var(--line)}
.creds dt{color:var(--navy);font-weight:600;font-size:15px}
.creds dd{margin:0;color:var(--ink-2);font-size:15px}
.principle figure{margin:0;min-width:0}
.principle figure img{width:100%;aspect-ratio:4/5;object-fit:cover}

/* before the decision */
.decide{background:var(--white);border-block:1px solid var(--line)}
.dec-list{border-top:1px solid var(--navy)}
.dec{display:grid;grid-template-columns:.9fr 40px 1.4fr;gap:28px;align-items:start;padding-block:34px;border-bottom:1px solid var(--line)}
.dec .ask small,.dec .why small{display:block;color:var(--gold);margin-bottom:10px}
.dec .ask q{display:block;font-size:clamp(21px,2.3vw,27px);font-weight:600;color:var(--navy);line-height:1.5;quotes:"«" "»"}
.dec .arrow{color:var(--gold);font-size:26px;line-height:1;padding-top:30px;text-align:center}
.dec .why h3{font-size:19px;color:var(--navy)}
.dec .why p{margin-top:8px;color:var(--ink-2);font-size:16px}
.decide .note{margin-top:30px;color:var(--ink-2);font-size:15px}

/* why it happens */
.why-sec .layout{display:grid;grid-template-columns:.75fr 1.25fr;gap:56px;align-items:start}
.why-sec .layout>div{min-width:0}
.why-sec figure{margin:0;position:sticky;top:90px;min-width:0}
.why-sec figure img{width:100%;aspect-ratio:3/4;object-fit:cover}
.tabs{display:flex;gap:0;border-bottom:1px solid var(--line);overflow-x:auto;scrollbar-width:none}
.tabs::-webkit-scrollbar{display:none}
.tab{font-family:var(--f-ar);font-size:16px;font-weight:500;background:none;border:0;border-bottom:2px solid transparent;margin-bottom:-1px;padding:12px 18px;color:var(--ink-2);cursor:pointer;white-space:nowrap;transition:color .2s,border-color .2s}
.tab:hover{color:var(--navy)}
.tab[aria-selected="true"]{color:var(--navy);border-bottom-color:var(--gold);font-weight:600}
.panel{padding-top:36px}
.panel[hidden]{display:none}
.panel h3{font-size:clamp(24px,2.6vw,32px);color:var(--navy);line-height:1.4}
.panel .blk{margin-top:26px;display:grid;grid-template-columns:120px 1fr;gap:20px;padding-top:20px;border-top:1px solid var(--line)}
.panel .blk b{color:var(--gold);font-size:14px;font-weight:600}
.panel .blk p{color:var(--ink);font-size:16.5px}

/* truth */
.truth{background:var(--navy);color:var(--paper)}
.myths{display:grid;grid-template-columns:repeat(2,1fr);gap:1px;background:var(--line-d);border:1px solid var(--line-d)}
.myth{background:var(--navy);padding:32px 30px;min-width:0}
.myth .said{display:flex;gap:12px;align-items:baseline;color:var(--mist);font-size:16px}
.myth .said s{text-decoration-color:rgba(207,164,68,.8);text-decoration-thickness:1px}
.myth .tag{flex:none;font-size:10px;color:var(--skin)}
.myth h3{margin-top:14px;font-size:19px;line-height:1.7;font-weight:500;color:var(--paper)}
.myth h3::before{content:"";display:block;width:28px;height:1px;background:var(--gold);margin-bottom:14px}

/* after the visit */
.after{padding-block:80px}
.after .wrap{display:grid;grid-template-columns:.8fr 1.2fr;gap:56px;align-items:start}
.after h2{font-size:clamp(26px,3vw,36px);color:var(--navy);margin-top:16px;line-height:1.35}
.after ul{list-style:none;margin:0;padding:0;border-top:1px solid var(--line)}
.after li{display:grid;grid-template-columns:150px 1fr;gap:20px;padding-block:18px;border-bottom:1px solid var(--line)}
.after li b{color:var(--navy);font-weight:600}
.after li span{color:var(--ink-2)}

/* services */
.services{background:var(--white);border-block:1px solid var(--line);overflow:hidden}
.svc-layout{display:grid;grid-template-columns:1.15fr .85fr;gap:72px;align-items:center}
.svc-list{list-style:none;margin:0;padding:0;border-top:1px solid var(--navy);min-width:0}
.svc-list li{display:grid;grid-template-columns:76px 1fr;gap:20px;align-items:baseline;padding-block:26px;border-bottom:1px solid var(--line);transition:padding .3s}
.svc-list li:hover{padding-inline-start:10px}
.svc-list .num{font-size:40px;line-height:1;color:var(--gold);font-weight:400;font-style:italic;font-variant-numeric:lining-nums}
.svc-list h3{font-size:clamp(21px,2.2vw,26px);color:var(--navy)}
.svc-list div>.en{display:block;text-align:right;font-size:18px;font-style:italic;color:var(--gold);margin-top:2px}
.svc-list p{margin-top:6px;color:var(--ink-2);font-size:15.5px}
.svc-art{position:relative;margin:0;min-width:0;padding-bottom:70px}
.svc-art .a{width:82%;aspect-ratio:4/5;object-fit:cover;margin-inline-start:auto;position:relative;z-index:1}
.svc-art .b{position:absolute;width:50%;aspect-ratio:3/4;object-fit:cover;bottom:0;inset-inline-start:0;z-index:2;border:10px solid var(--white)}
.svc-art .ring{position:absolute;width:300px;height:300px;border-radius:50%;border:1px solid rgba(207,164,68,.45);top:-60px;inset-inline-end:-80px;z-index:0}

/* faq */
.faq .wrap{display:grid;grid-template-columns:.8fr 1.2fr;gap:56px;align-items:start}
.faq .sec-head{margin-bottom:0}
.qa{border-top:1px solid var(--navy)}
details{border-bottom:1px solid var(--line)}
summary{list-style:none;cursor:pointer;display:flex;justify-content:space-between;gap:20px;align-items:center;padding-block:22px;font-size:18px;font-weight:600;color:var(--navy)}
summary::-webkit-details-marker{display:none}
summary::after{content:"+";font-family:var(--f-util);font-weight:400;font-size:24px;color:var(--gold);flex:none;transition:transform .2s}
details[open] summary::after{transform:rotate(45deg)}
details p{padding-bottom:24px;color:var(--ink-2);font-size:16px;max-width:40em}

/* media */
.media{background:var(--navy);color:var(--paper)}
.media .wrap{display:grid;grid-template-columns:.8fr 1.2fr;gap:64px;align-items:center}
.media figure{margin:0;min-width:0}
.media figure img{width:100%;aspect-ratio:2/3;object-fit:cover}
.media h2{font-size:clamp(28px,3.2vw,40px);margin-top:16px;line-height:1.3}
.media p.lead{margin-top:18px;color:var(--mist);font-size:17px;max-width:32em}
.press{margin-top:34px;border-top:1px solid var(--line-d)}
.press div{display:flex;justify-content:space-between;align-items:baseline;gap:16px;padding-block:18px;border-bottom:1px solid var(--line-d)}
.press b{font-size:18px;font-weight:600}
.press span{color:var(--mist);font-size:14px;white-space:nowrap}
.media .btn{margin-top:32px}

/* contact */
.contact .wrap{display:grid;grid-template-columns:1fr 1fr;gap:64px}
.contact h2{font-size:clamp(28px,3.2vw,40px);color:var(--navy);margin-top:16px;line-height:1.3}
.contact p.lead{margin-top:18px;color:var(--ink-2);max-width:30em}
.links{display:grid;border-top:1px solid var(--line)}
.links a,.links .row{display:grid;grid-template-columns:44px 1fr auto;align-items:center;gap:16px;padding-block:18px;border-bottom:1px solid var(--line);text-decoration:none;transition:padding .2s}
.links a:hover{padding-inline-start:8px}
.links .ic{width:44px;height:44px;border:1px solid var(--line);display:grid;place-items:center;color:var(--navy)}
.links .ic svg{width:20px;height:20px}
.links b{display:block;color:var(--navy);font-size:16.5px;font-weight:600}
.links small{display:block;color:var(--ink-2);font-size:14px;direction:ltr;text-align:right;unicode-bidi:isolate}
.links .go{color:var(--gold);font-size:20px}
.copy{font-family:var(--f-ar);font-size:13px;background:none;border:1px solid var(--line);padding:6px 12px;color:var(--navy);cursor:pointer}
.copy:hover{border-color:var(--gold)}

footer{background:var(--navy);color:var(--mist)}
footer .wrap{display:flex;justify-content:space-between;align-items:center;gap:24px;flex-wrap:wrap;padding-block:44px}
footer .f-brand{display:flex;align-items:center;gap:16px}
footer img{height:46px;width:auto}
footer .en{font-size:20px;font-style:italic;color:var(--skin)}
footer small{font-size:13px}
.disc{font-size:12.5px;color:var(--mist);opacity:.75;border-top:1px solid var(--line-d);padding-block:18px}

/* motion */
.hero-ring{position:absolute;left:-420px;top:-260px;width:780px;height:780px;pointer-events:none;overflow:visible}
.hero-ring circle{fill:none;stroke:rgba(207,164,68,.32);stroke-width:1}
.hero-ring .r2{stroke:rgba(207,164,68,.14)}
.hero::before{display:none}
.hero h1{overflow:hidden;padding-block:.08em .14em}
.hero h1 .ln{display:inline-block}
header{transition:box-shadow .4s}
header .wrap{transition:padding .4s}
header.scrolled{box-shadow:0 10px 30px rgba(8,14,28,.35)}
header.scrolled .wrap{padding-block:8px}
.brand img{transition:height .4s}
header.scrolled .brand img{height:28px}
.btn{background:linear-gradient(var(--gold),var(--gold)) no-repeat right center/0% 100%;transition:background-size .5s cubic-bezier(.7,0,.2,1),color .4s,border-color .4s}
.btn:hover{background-color:transparent;background-size:100% 100%}
.btn.ghost{background-image:linear-gradient(var(--paper),var(--paper))}
.btn.ghost:hover{background-color:transparent}
.svc-list li{position:relative}
.svc-list li::after{content:"";position:absolute;bottom:-1px;right:0;height:1px;width:0;background:var(--gold);transition:width .7s cubic-bezier(.7,0,.2,1)}
.svc-list li:hover::after{width:100%}
.svc-list .num{transition:transform .5s cubic-bezier(.2,.7,.2,1)}
.svc-list li:hover .num{transform:translateX(-6px)}
.svc-art img,.media figure img,.portrait img{will-change:translate}
details[open] p{animation:qa .6s cubic-bezier(.2,.7,.2,1)}
@keyframes qa{from{opacity:0;transform:translateY(-8px)}to{opacity:1;transform:none}}

.js .rv{opacity:0;translate:0 34px;transition:opacity 1.1s cubic-bezier(.2,.7,.2,1),translate 1.1s cubic-bezier(.2,.7,.2,1);transition-delay:var(--d,0s)}
.js .rv.in{opacity:1;translate:0 0}
.js .hero h1 .ln{transform:translateY(110%);transition:transform 1.3s cubic-bezier(.16,1,.3,1) .15s}
.js .hero.in h1 .ln{transform:none}
.js .eyebrow::after{width:0;transition:width 1.2s cubic-bezier(.7,0,.2,1) .4s}
.js .in .eyebrow::after,.js .eyebrow.in::after,.js .in.eyebrow::after{width:56px}
.js .rv-img{clip-path:inset(100% 0 0 0);scale:1.14;transition:clip-path 1.5s cubic-bezier(.77,0,.18,1),scale 2.2s cubic-bezier(.16,1,.3,1);transition-delay:var(--d,0s)}
.js .rv-img.in{clip-path:inset(0 0 0 0);scale:1}
.js .hero-ring circle{stroke-dasharray:2460;stroke-dashoffset:2460;transition:stroke-dashoffset 3.2s cubic-bezier(.65,0,.35,1) .3s}
.js .hero-ring .r2{transition-delay:.9s}
.js .hero.in .hero-ring circle{stroke-dashoffset:0}
.hero-ring{animation:spin 120s linear infinite}
@keyframes spin{to{transform:rotate(360deg)}}
@media (prefers-reduced-motion:reduce){
  .js .rv,.js .rv-img,.js .hero h1 .ln{opacity:1!important;translate:none!important;transform:none!important;clip-path:none!important;scale:1!important}
  .js .hero-ring circle{stroke-dashoffset:0}
  .js .eyebrow::after{width:56px}
  .hero-ring{animation:none}
}

@media (max-width:860px){
  nav{display:none}
  section{padding-block:76px}
  .hero .wrap,.principle .wrap,.why-sec .layout,.after .wrap,.faq .wrap,.media .wrap,.contact .wrap{grid-template-columns:1fr;gap:40px}
  .hero .wrap{padding-block:48px 0}
  .hero-text{padding-bottom:0}
  .portrait img{max-width:340px;margin-inline:auto}
  .principle figure{max-width:360px}
  .dec{grid-template-columns:1fr;gap:12px;padding-block:28px}
  .dec .arrow{display:none}
  .why-sec figure{display:none}
  .tabs{flex-wrap:wrap;overflow:visible}
  .tab{padding:10px 14px}
  .myths{grid-template-columns:1fr}
  .svc-layout{grid-template-columns:1fr;gap:48px}
  .svc-art{max-width:420px;margin-inline:auto;width:100%}
  .media figure{max-width:320px}
}
@media (max-width:520px){
  .svc-list li{grid-template-columns:52px 1fr;gap:12px}
  .svc-list .num{font-size:32px}
  .creds div,.after li,.panel .blk{grid-template-columns:1fr;gap:4px}
  .press div{flex-direction:column;gap:2px}
  .myth{padding:26px 22px}
}
</style>

